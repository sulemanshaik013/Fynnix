<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="fynnix.db" />
        <exclude domain="database" path="fynnix.db-journal" />
        <exclude domain="database" path="fynnix.db-wal" />
        <exclude domain="database" path="fynnix.db-shm" />
        <exclude domain="sharedpref" path="fynnix_user_prefs.xml" />
        <exclude domain="sharedpref" path="fynnix_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="fynnix.db" />
        <exclude domain="sharedpref" path="fynnix_secure.xml" />
    </device-transfer>
</data-extraction-rules>
